NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER=
MONGODB_DB=quantumchat

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Blob storage — Google Drive only (no local uploads/ folder)
# ---------------------------------------------------------------------------
# 1) Create a Google Cloud service account with Drive access
# 2) Create a Shared Drive folder and share it ONLY with that service account (Content manager)
# 3) Paste folder id only (not the full URL) + credentials (PRIVATE_KEY: keep \n escapes)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
